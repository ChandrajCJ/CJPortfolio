# npm lockfiles contain base64 SHA-512 integrity digests for every package.
# These are content hashes, not credentials — Talisman's filecontent detector
# flags them as false positives.
fileignoreconfig:
  - filename: package-lock.json
    ignore_detectors:
      - filecontent

# Talisman's pattern detector reads anything shaped like `key = '...'` as a
# secret assignment. These are React list keys, a keyboard Escape check and a
# translation key - identifiers, not credentials.
allowed_patterns:
  - 'key=\{'
  - 'e\.key === ''Escape'''
  - 'const onKey = \(e\) =>'
  - 'locationKey: ''puducherry'''
