# ---------------------------------------------------------------------------
# Client-side (bundled into the browser build - never put real secrets here)
# ---------------------------------------------------------------------------

# EmailJS credentials for the contact form. These are public-by-design browser
# keys, but keep them out of source control and lock the allowed domains in the
# EmailJS dashboard to stop form abuse: https://dashboard.emailjs.com/admin
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Optional overrides for the cookie-free Umami analytics. The live site's
# website ID (public by design: it appears in the page) and hostname are the
# defaults in src/components/Analytics.jsx; set these only to change them.
VITE_UMAMI_WEBSITE_ID=
# Hostnames to count (comma-separated), so local builds and previews stay out.
VITE_UMAMI_DOMAINS=
# Optional: a self-hosted Umami's script URL. Defaults to Umami Cloud.
VITE_UMAMI_SRC=

# ---------------------------------------------------------------------------
# Server-side only (Netlify Functions - NOT exposed to the browser)
# ---------------------------------------------------------------------------

# Powers the Astro chat assistant. Get a free key at https://aistudio.google.com/apikey
# Set this in the Netlify UI under Site settings -> Environment variables.
# It must NOT have a VITE_ prefix, or Vite would inline it into the client
# bundle and leak it publicly.
# Without it, /api/astro returns 503 and the widget shows a graceful fallback.
GEMINI_API_KEY=

# Optional model override. Defaults to gemini-3.6-flash, which is on the free tier.
GEMINI_MODEL=
